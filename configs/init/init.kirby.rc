on post-fs-data
    chown system system /sys/class/leds/vibrator_l/activate
    chown system system /sys/class/leds/vibrator_l/activate_mode
    chown system system /sys/class/leds/vibrator_l/duration
    chown system system /sys/class/leds/vibrator_l/index
    chown system system /sys/class/leds/vibrator_l/gain
    chown system system /sys/class/leds/vibrator_l/double
    chown system system /sys/class/leds/vibrator_r/activate
    chown system system /sys/class/leds/vibrator_r/activate_mode
    chown system system /sys/class/leds/vibrator_r/duration
    chown system system /sys/class/leds/vibrator_r/index
    chown system system /sys/class/leds/vibrator_r/gain
    chown system system /sys/class/leds/vibrator_r/double

#camera property start
on property:vendor.lenovocamera.packagename.zui=1
    setprop vendor.camera.packagename.zui ${vendor.lenovocamera.packagename.zui}

on property:vendor.lenovocamera.packagename.cts=1
    setprop vendor.camera.packagename.cts ${vendor.lenovocamera.packagename.cts}

on property:vendor.lenovocamera.packagename.client=1
    setprop vendor.camera.packagename.client ${vendor.lenovocamera.packagename.client}

on property:vendor.lenovocamera.packagename.camera0.client=1
    setprop vendor.camera.packagename.camera0.client ${vendor.lenovocamera.packagename.camera0.client}

on property:vendor.lenovocamera.packagename.camera1.client=1
    setprop vendor.camera.packagename.camera1.client ${vendor.lenovocamera.packagename.camera1.client}

on property:vendor.lenovocamera.pandora.enable=1
    setprop vendor.camera.pandora.enable ${vendor.lenovocamera.pandora.enable}

on property:vendor.lenovocamera.pandora.synthesis.targetapp=1
    setprop vendor.camera.pandora.synthesis.targetapp ${vendor.lenovocamera.pandora.synthesis.targetapp}

on property:vendor.lenovocamera.cammotorfeedbacktype=1
    setprop vendor.camera.cammotorfeedbacktype ${vendor.lenovocamera.cammotorfeedbacktype}

on property:vendor.lenovovideo.big.file.enable=1
    setprop vendor.video.big.file.enable ${vendor.lenovovideo.big.file.enable}

on property:vendor.lenovocamera.frontcamera.status=1
    setprop vendor.camera.frontcamera.status ${vendor.lenovocamera.frontcamera.status}

on property:vendor.lenovocamera.device.orientation=1
    setprop vendor.camera.device.orientation ${vendor.lenovocamera.device.orientation}

on property:persist.lenovo.tblenovo.enableThirdAppFB=1
    setprop persist.odm.tblenovo.enableThirdAppFB ${persist.lenovo.tblenovo.enableThirdAppFB}

on property:persist.lenovo.tblenovo.enableThirdAppBokeh=1
    setprop persist.odm.tblenovo.enableThirdAppBokeh ${persist.lenovo.tblenovo.enableThirdAppBokeh}

on property:persist.lenovo.tblenovo.orientation=1
    setprop persist.odm.tblenovo.orientation ${persist.lenovo.tblenovo.orientation}

on property:persist.lenovo.camera.blackMask=1
    setprop persist.vendor.camera.blackMask ${persist.lenovo.camera.blackMask}

on property:persist.lenovo.camera.beauty.level=1
    setprop persist.odm.camera.beauty.level ${persist.lenovo.camera.beauty.level}

on property:persist.lenovo.camera.blur.level=1
    setprop persist.vendor.camera.blur.level ${persist.lenovo.camera.blur.level}

on property:persist.lenovo.camera.seg.index=1
    setprop persist.vendor.camera.seg.index ${persist.lenovo.camera.seg.index}

on property:persist.lenovo.camera.superportraitvideo.enable=1
    setprop persist.odm.camera.superportraitvideo.enable ${persist.lenovo.camera.superportraitvideo.enable}

on property:persist.lenovo.camera.superportraitvideo.level=1
    setprop persist.odm.camera.superportraitvideo.level ${persist.lenovo.camera.superportraitvideo.level}

on property:persist.lenovo.camera.autoframing.switcher=1
    setprop persist.odm.camera.autoframing.enable ${persist.lenovo.camera.autoframing.switcher}
#camera property end